        }
      }
    },
    "/api/v1/datasets/{dataset_id}/scene": {
      "get": {
        "summary": "Scene",
        "description": "Plotly 3D figure at the solved body pose (SI: m, rad; rotations about the CG).",
        "operationId": "scene_api_v1_datasets__dataset_id__scene_get",
        "parameters": [
          {
            "name": "dataset_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Dataset Id"
            }
          },
          {
            "name": "heave",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 0.2,
              "minimum": -0.2,
              "default": 0.0,
              "title": "Heave"
            }
          },
          {
            "name": "roll",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 0.35,
              "minimum": -0.35,
              "default": 0.0,
              "title": "Roll"
            }
          },
          {
            "name": "pitch",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 0.35,
              "minimum": -0.35,
              "default": 0.0,
              "title": "Pitch"
            }
          },
          {
            "name": "rack",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 0.2,
              "minimum": -0.2,
              "default": 0.0,
              "title": "Rack"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Scene Api V1 Datasets  Dataset Id  Scene Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/datasets/{dataset_id}/hardpoints": {
      "get": {
        "summary": "Hardpoints",
        "description": "Every hardpoint after mirroring, in SI (right side from ``right_overrides`` if set).",
        "operationId": "hardpoints_api_v1_datasets__dataset_id__hardpoints_get",
        "parameters": [
          {
            "name": "dataset_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Dataset Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HardpointOut"
                  },
                  "title": "Response Hardpoints Api V1 Datasets  Dataset Id  Hardpoints Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/runs/{run_id}/history": {
      "get": {
        "summary": "History",
        "operationId": "history_api_v1_runs__run_id__history_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/export": {
      "post": {
        "summary": "Export",
        "description": "Write a snapshot of the open datasets into the workspace.",
        "operationId": "export_api_v1_export_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/ExportRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Req"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExportOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/browse": {
      "get": {
        "summary": "Browse",
        "operationId": "browse_api_v1_browse_get",
        "parameters": [
          {
            "name": "dir",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Dir"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BrowseOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BrowseEntry": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "path": {
            "type": "string",
            "title": "Path",
            "description": "Workspace-relative POSIX path."
          },
          "kind": {
            "type": "string",
            "enum": [
              "dir",
              "vehicle",
              "bundle",
              "report",
              "run",
              "other"
            ],
            "title": "Kind"
          }
        },
        "type": "object",
        "required": [
          "name",
          "path",
          "kind"
        ],
        "title": "BrowseEntry",
        "description": "One directory entry of the file picker."
      },
      "BrowseOut": {
        "properties": {
          "dir": {
            "type": "string",
            "title": "Dir",
            "description": "Workspace-relative path of the listed directory ('' = root)."
          },
          "parent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/BrowseEntry"
            },
            "type": "array",
            "title": "Entries"
          }
        },
        "type": "object",
        "required": [
          "dir",
          "parent",
          "entries"
        ],
        "title": "BrowseOut",
        "description": "Listing of a workspace directory."
      },
      "DatasetOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "kind": {
            "type": "string",
            "enum": [
              "vehicle",
              "bundle",
              "run"
            ],
            "title": "Kind"
          },
          "source": {
            "type": "string",
            "title": "Source",
            "description": "Workspace-relative path of the opened file or folder."
          },
          "color": {
            "type": "integer",
            "title": "Color",
            "description": "Colour index into the dataset palette."
          },
          "studies": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Studies",
            "description": "Names of the tables this dataset has."
          },
          "run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Id"
          },
          "params": {
            "additionalProperties": true,
            "type": "object",
            "title": "Params",
            "description": "Study parameters (SI)."
          },
          "steps": {
            "type": "integer",
            "title": "Steps",
            "description": "Points per sweep of the solved tables.",
            "default": 31
          },
          "resolution_fixed": {
            "type": "boolean",
            "title": "Resolution Fixed",
            "description": "True for bundles and runs: the stored resolution cannot be changed.",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "id",
          "label",
          "kind",
          "source",
          "color",
          "studies"
        ],
        "title": "DatasetOut",
        "description": "Summary metadata of one open dataset (no tables)."
      },
      "DatasetPatch": {
        "properties": {
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "color": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Color"
          },
          "steps": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 401.0,
                "minimum": 3.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Steps",
            "description": "Re-solve with this many points per sweep (vehicle files only)."
          }
        },
        "type": "object",
        "title": "DatasetPatch",
        "description": "Editable dataset attributes."
      },
      "ExportOut": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path",
            "description": "Workspace-relative path of the written file."
          },
          "size": {
            "type": "integer",
            "title": "Size",
            "description": "File size in bytes."
          }
        },
        "type": "object",
        "required": [
          "path",
          "size"
        ],
        "title": "ExportOut",
        "description": "Result of a snapshot export."
      },
      "ExportRequest": {
        "properties": {
          "out": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Out",
            "description": "Workspace-relative output file (default: timestamped name)."
          },
          "overwrite": {
            "type": "boolean",
            "title": "Overwrite",
            "description": "Replace an existing snapshot file (never any other file).",
            "default": false
          }
        },
        "type": "object",
        "title": "ExportRequest",
        "description": "Export the open datasets as a self-contained HTML snapshot."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HardpointOut": {
        "properties": {
          "axle": {
            "type": "string",
            "enum": [
              "front",
              "rear"
            ],
            "title": "Axle"
          },
          "point": {
            "type": "string",
            "title": "Point"
          },
          "side": {
            "type": "string",
            "enum": [
              "left",
              "right"
            ],
            "title": "Side"
          },
          "x": {
            "type": "number",
            "title": "X",
            "description": "Metres."
          },
          "y": {
            "type": "number",
            "title": "Y",
            "description": "Metres."
          },
          "z": {
            "type": "number",
            "title": "Z",
            "description": "Metres."
          },
          "overridden": {
            "type": "boolean",
            "title": "Overridden",
            "description": "True for a right point taken from ``right_overrides``.",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "axle",
          "point",
          "side",
          "x",
          "y",
          "z"
        ],
        "title": "HardpointOut",
        "description": "One hardpoint of one corner after mirroring (SI, ISO 8855 vehicle frame)."
      },
      "HealthOut": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "workspace": {
            "type": "string",
            "title": "Workspace",
            "description": "Absolute path of the workspace root."
          },
          "pose": {
            "items": {
              "$ref": "#/components/schemas/PoseInput"
            },
            "type": "array",
            "title": "Pose",
            "description": "3D pose inputs."
          }
        },
        "type": "object",
        "required": [
          "version",
          "workspace"
        ],
        "title": "HealthOut",
        "description": "Server liveness, package version and workspace root."
      },
      "HistoryOut": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "columns": {
            "additionalProperties": {
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            },
            "type": "object",
            "title": "Columns"
          },
          "meta": {
            "additionalProperties": true,
            "type": "object",
            "title": "Meta"
          },
          "result": {
            "additionalProperties": true,
            "type": "object",
            "title": "Result"
          },
          "objectives": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Objectives",
            "description": "History columns of the objectives (``f_*``, no total)."
          },
          "best_so_far": {
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array",
            "title": "Best So Far",
            "description": "Running best feasible ``f_total`` per history row."
          },
          "pareto_all": {
            "items": {
              "type": "boolean"
            },
            "type": "array",
            "title": "Pareto All",
            "description": "Per history row: feasible and non-dominated in all objectives (needs >= 2 objectives)."
          },
          "pareto_pairs": {
            "additionalProperties": {
              "items": {
                "type": "boolean"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Pareto Pairs",
            "description": "Per objective pair ``'f_a|f_b'`` (objective order): per history row, feasible and non-dominated in those two objectives only."
          },
          "knee_eval_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Knee Eval Id",
            "description": "``eval_id`` of the front knee."
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "columns",
          "meta",
          "result"
        ],
        "title": "HistoryOut",
        "description": "Optimizer history (columnar) with the run's ``meta.json`` and ``result.json``."
      },
      "OpenRequest": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          }
        },
        "type": "object",
        "required": [
          "path"
        ],
        "title": "OpenRequest",
        "description": "Open a path (absolute, or relative to the workspace)."
      },
      "PoseInput": {
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "heave",
              "roll",
              "pitch",
              "rack"
            ],
            "title": "Name"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "si_unit": {
            "type": "string",
            "title": "Si Unit"
          },
          "display_unit": {
            "type": "string",
            "title": "Display Unit"
          },
          "factor": {
            "type": "number",
            "title": "Factor",
            "description": "Display value = SI value x factor."
          },
          "param": {
            "type": "string",
            "title": "Param",
            "description": "Dataset study parameter that sets the slider range."
          },
          "param_factor": {
            "type": "number",
            "title": "Param Factor",
            "description": "Display value of the parameter = parameter x this."
          },
          "default_max": {
            "type": "number",
            "title": "Default Max",
            "description": "Range (+-, display unit) when the parameter is unset."
          },
          "step": {
