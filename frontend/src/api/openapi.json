    "/api/v1/datasets/{dataset_id}/summary": {
      "get": {
        "summary": "Summary",
        "operationId": "summary_api_v1_datasets__dataset_id__summary_get",
        "parameters": [
          {
            "name": "dataset_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Dataset Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
